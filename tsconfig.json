{
  // The browser app: src/ compiles to dist/js/ as ES modules, one file per
  // source file (no bundler). Sources import each other with .ts
  // extensions, which the compiler rewrites to .js; the same files run
  // directly in Node (type stripping) for the tests.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist/js",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"]
}
